{
  "name": "account-deck",
  "version": "1.0.1",
  "description": "Switch between saved Claude, Claude Code, Codex, Cursor and Antigravity accounts and see usage, from the menu bar or system tray.",
  "author": "Account Deck contributors",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "web": "node server.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "icons": "node assets/make-logo.mjs && electron assets/render-icons.cjs",
    "dist": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.accountdeck.app",
    "productName": "Account Deck",
    "files": [
      "main.mjs",
      "server.mjs",
      "lib/**",
      "providers/**",
      "public/**",
      "package.json",
      "assets/*.png",
      "assets/logo.svg"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "build/icon.icns",
      "identity": "-",
      "artifactName": "Account-Deck-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "Account-Deck-linux-${arch}.${ext}",
      "synopsis": "Switch between saved AI tool accounts"
    },
    "directories": {
      "buildResources": "build"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "title": "Account Deck",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "nsis": {
      "artifactName": "Account-Deck-windows-${arch}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Account Deck"
    },
    "publish": null
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "account-switcher",
    "menu-bar",
    "electron"
  ],
  "homepage": "https://github.com/MusmanShahzad/account-deck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MusmanShahzad/account-deck.git"
  },
  "bugs": {
    "url": "https://github.com/MusmanShahzad/account-deck/issues"
  }
}
